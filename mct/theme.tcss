/* FENNIA MCT — orange rice, gum-style double borders on Mocha base */

Screen {
    background: $background;
    color: $foreground;
}

/* ---------------------------------------------------------------- top bar */

#topbar {
    height: 4;
    padding: 0 1;
    background: $background;
    border-bottom: solid $border;
}
#brand {
    width: auto;
    padding: 1 1 0 0;
}
#tsline {
    width: 1fr;
    padding: 1 1 0 1;
    text-align: right;
}
#clock {
    width: auto;
    color: $primary;
}

/* ---------------------------------------------------------------- main */

#main {
    height: 1fr;
}
#left {
    width: 46;
    min-width: 36;
}
#right {
    width: 1fr;
}

#filter {
    height: 1;
    border: none;
    padding: 0 1;
    margin: 0 1;
    background: $surface;
    color: $primary;
}
#filter:focus {
    background: $surface;
    border: none;
}

DataTable {
    border: double $border;
    border-title-color: $primary;
    border-title-style: bold;
    background: $background;
    scrollbar-color: $primary;
    scrollbar-background: $background;
    scrollbar-size-vertical: 1;
}
DataTable:focus {
    border: double $primary;
}
DataTable > .datatable--header {
    background: $background;
    color: $secondary;
    text-style: bold;
}
DataTable > .datatable--cursor {
    background: $primary 20%;
    color: $foreground;
}
DataTable:focus > .datatable--cursor {
    background: $primary 35%;
}
DataTable > .datatable--hover {
    background: $primary 10%;
}

#units {
    height: 1fr;
    margin: 0 0 0 1;
}
#unit-actions {
    height: 1;
    margin: 0 0 0 1;
    padding: 0 1;
}
#unit-actions Button {
    height: 1;
    min-width: 10;
    margin-right: 1;
    border: none;
    padding: 0 1;
    background: $surface;
    color: $primary;
    text-style: bold;
}
#unit-actions Button:hover {
    background: $primary 30%;
}
#unit-actions Button:focus {
    background: $primary;
    color: $background;
    text-style: bold;
}

#guests {
    height: 12;
    margin: 0 1 0 0;
}

#detail {
    height: 1fr;
    border: double $border;
    border-title-color: $primary;
    border-title-style: bold;
    padding: 0 2;
    margin: 0 1 0 0;
    background: $background;
}

/* ---------------------------------------------------------------- log */

#log {
    height: 9;
    scrollbar-size-horizontal: 0;
    border: double $border;
    border-title-color: $primary;
    border-title-style: bold;
    padding: 0 1;
    margin: 0 1;
    background: $background;
    scrollbar-color: $primary;
    scrollbar-background: $background;
    scrollbar-size-vertical: 1;
}

/* ---------------------------------------------------------------- footer */

Footer {
    height: 2;
    background: $background;
    border-top: solid $border;
}
Footer > .footer--key {
    background: $background;
    color: $primary;
    text-style: bold;
}
Footer > .footer--description {
    background: $background;
    color: $secondary;
}
Footer > .footer--highlight {
    background: $primary 20%;
}
Footer > .footer--highlight-key {
    background: $primary;
    color: $background;
}
FooterKey {
    background: $background;
}
FooterKey .footer-key--key {
    color: $primary;
    background: $background;
}
FooterKey .footer-key--description {
    color: $secondary;
    background: $background;
}
FooterKey:hover {
    background: $primary 20%;
}

Toast {
    background: $surface;
    border: double $primary;
    color: $foreground;
}
Toast.-warning {
    border: double $warning;
}

/* ---------------------------------------------------------------- boot */

BootScreen {
    background: $background;
    align: center middle;
}
#boot {
    width: 84;
    height: auto;
    border: double $primary;
    padding: 1 3;
    background: $background;
}
#boot-fox {
    width: auto;
    margin-bottom: 1;
}
#boot-mark {
    width: auto;
}
#boot-sub {
    width: auto;
    margin-bottom: 1;
}
#boot-log {
    height: 10;
    scrollbar-size-horizontal: 0;
    background: $background;
    padding: 0 1;
    border-top: solid $border;
}
#boot-hint {
    width: auto;
    height: 1;
}

/* ---------------------------------------------------------------- unit form */

UnitForm {
    background: $background 60%;
    align: center middle;
}
#form {
    width: 78;
    height: auto;
    border: double $primary;
    background: $background;
    padding: 1 2;
}
#form-title {
    height: 1;
    margin-bottom: 1;
}
#form-grid {
    grid-size: 2;
    grid-columns: 11 1fr;
    grid-rows: 1;
    grid-gutter: 0 1;
    height: auto;
}
#form-grid Label {
    color: $secondary;
    text-style: bold;
    padding: 0;
    height: 1;
}
#form-grid Input {
    height: 1;
    border: none;
    padding: 0 1;
    background: $surface;
    color: $foreground;
}
#form-grid Input:focus {
    background: $primary 25%;
}
#form-grid Select {
    height: 1;
    border: none;
}
#form-grid Select > SelectCurrent {
    height: 1;
    border: none;
    padding: 0 1;
    background: $surface;
    color: $foreground;
}
#form-grid Select:focus > SelectCurrent {
    background: $primary 25%;
}
#form-grid SelectOverlay {
    border: double $primary;
    background: $background;
    color: $foreground;
}
#form-error {
    height: 1;
    margin-top: 1;
}
#form-buttons {
    height: 1;
    margin-top: 1;
}
#form-buttons Button {
    height: 1;
    min-width: 10;
    margin-right: 1;
    border: none;
    padding: 0 2;
    background: $surface;
    color: $primary;
    text-style: bold;
}
#form-buttons Button.-primary {
    background: $primary;
    color: $background;
}
#form-buttons Button.-error {
    background: $surface;
    color: $error;
}
#form-buttons Button:hover, #form-buttons Button:focus {
    background: $primary 60%;
    color: $background;
}
#form-buttons Button.-error:hover, #form-buttons Button.-error:focus {
    background: $error;
    color: $background;
}
#form-spacer {
    width: 1fr;
}
#form-hint {
    height: 1;
    margin-top: 1;
}
