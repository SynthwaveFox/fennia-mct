# Diff for .config/yadm/system/usr-local-bin/session-chooser
#
# "master control" boots straight into MCT: cage (single-window Wayland
# kiosk, `pacman -S cage`) runs ghostty fullscreen with mct, so fonts, colours
# and glyphs are the real thing — the bare VT font can't draw ▰▱◐◌. Quitting
# mct (q) exits cage and returns to this menu.
#
# Absolute paths on purpose: greetd runs this menu with a different $HOME
# than your shell, and ghostty silently falls back to defaults if the config
# file isn't found. ~/.config/ghostty/mct-boot is contrib/ghostty-mct with
# `font-size = 16` (cage doesn't apply niri's output scale — tune to taste)
# and `fullscreen = true`.
-    "niri" "terminal" "reboot" "power off")
+    "niri" "master control" "terminal" "reboot" "power off")
   case "$choice" in
     "niri")      exec niri-session ;;
+    "master control")
+      cage -- ghostty --config-file=/home/YOURUSER/.config/ghostty/mct-boot \
+                      --class=fennia.mct -e /home/YOURUSER/.local/bin/mct
+      ;;
