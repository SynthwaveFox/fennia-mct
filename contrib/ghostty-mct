# ~/.config/ghostty/mct  — used via:  ghostty --config-file=~/.config/ghostty/mct -e mct
# (or just put these in your main ghostty config)
theme = catppuccin-mocha
background = #181825
foreground = #cdd6f4
cursor-color = #ff8a00
selection-background = #4d443b
palette = 3=#ff8a00
palette = 11=#ffb347
font-family = JetBrainsMono Nerd Font
font-size = 11
window-padding-x = 6
window-padding-y = 4
window-decoration = false
confirm-close-surface = false
fullscreen = true
